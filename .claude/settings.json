{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "defaultShell": "powershell",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "& \"${CLAUDE_PROJECT_DIR}/scripts/gates/agent-write-dispatch.ps1\"",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "decagram-council-write-guard"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "& \"${CLAUDE_PROJECT_DIR}/scripts/gates/agent-shell-dispatch.ps1\"",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "decagram-council-shell-guard"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"${CLAUDE_PROJECT_DIR}/scripts/gates/story-gate.ps1\" 'TaskCompleted'",
            "shell": "powershell",
            "timeout": 600,
            "statusMessage": "decagram-council-story-gate"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"${CLAUDE_PROJECT_DIR}/scripts/gates/story-gate.ps1\" 'TeammateIdle'",
            "shell": "powershell",
            "timeout": 600,
            "statusMessage": "decagram-council-story-gate"
          }
        ]
      }
    ]
  }
}
