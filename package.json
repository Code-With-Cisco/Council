{
  "name": "decagram-council",
  "productName": "Decagram Council",
  "version": "0.2.0",
  "private": true,
  "description": "Windows mission control for Claude Code and Codex agents",
  "main": "dist/src/ui/main.js",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:codex-live": "npm run build && node scripts/verify-codex-app-server.mjs",
    "harness": "tsx src/integration/harness/cli.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win dir",
    "dist:win": "npm run build && electron-builder --win",
    "release:win": "npm run build && electron-builder --win --publish always",
    "build:icon": "powershell.exe -NoProfile -NonInteractive -File scripts/build-icon.ps1"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9",
    "yaml": "^2.7.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.decagram.council",
    "productName": "Decagram Council",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/src/**/*",
      "src/ui/preload.cjs",
      "src/ui/renderer/**/*",
      "scripts/gates/*.ps1",
      ".claude/agents/*.md",
      ".claude/settings.json",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Code-With-Cisco",
      "repo": "Council",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Decagram Council"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Decagram Council"
    }
  }
}
